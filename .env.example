# ─────────────────────────────────────────────────────────────
# Database (Neon or local Postgres from docker-compose)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://crealify:crealify@localhost:5433/crealify?sslmode=disable"

# ─────────────────────────────────────────────────────────────
# Auth — Firebase
# Get these from Firebase console → Project settings → Web app.
# Service account JSON: Project settings → Service accounts → Generate new private key.
# Paste the WHOLE JSON as a single-line string for FIREBASE_ADMIN_CREDENTIALS.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
FIREBASE_ADMIN_CREDENTIALS=""

# ─────────────────────────────────────────────────────────────
# Storage — Cloudflare R2 (or any S3-compatible)
# For local dev, point to MinIO from docker-compose.
# ─────────────────────────────────────────────────────────────
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="auto"
STORAGE_BUCKET="crealify-assets"
STORAGE_ACCESS_KEY_ID="crealify"
STORAGE_SECRET_ACCESS_KEY="crealify-secret"
STORAGE_PUBLIC_URL="http://localhost:9000/crealify-assets"

# ─────────────────────────────────────────────────────────────
# Inngest — local dev server is included in docker-compose
# ─────────────────────────────────────────────────────────────
INNGEST_EVENT_KEY="local-dev"
INNGEST_SIGNING_KEY="local-dev"
INNGEST_DEV="1"

# ─────────────────────────────────────────────────────────────
# Vault — master key for encrypting user-supplied API tokens at rest.
# 32 random bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ─────────────────────────────────────────────────────────────
MASTER_KEY=""

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
